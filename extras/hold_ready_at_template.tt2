[%- USE date -%]
[%- holds = target -%]
[%- user = holds.0.usr -%]
[%- sms_number = holds.0.sms_notify -%]
[%- sanitized_sms = sms_number.replace('[-\s()]', '', 'g') -%]
To: [%- params.recipient_email %]
Bcc: [%- params.bcc_email || '' %]
From: [%- params.sender_email %]
Date: [%- date.format(date.now, '%a, %d %b %Y %T -0000', gmt => 1) %]
Subject: HOLDRDY+[% sanitized_sms %]
Auto-Submitted: auto-generated

[% FOR hold IN holds %]
[%- copy_details = helpers.get_copy_bib_basics(hold.current_copy.id) -%]
[%- shelf_time = hold.shelf_time ? date.format(helpers.format_date(hold.shelf_time), '%Y-%m-%d') : '' -%]
[%- expire_time = hold.shelf_expire_time ? date.format(helpers.format_date(hold.shelf_expire_time), '%Y-%m-%d') : '' -%]
[%- sanitized_title = copy_details.title.replace('[\r\n\t]+', ' ', 'g').replace('\s+', ' ', 'g') -%]
[%- sanitized_title %]|[% shelf_time %]|[% hold.current_copy.barcode %]|[% user.card.barcode %]|[% hold.pickup_lib.shortname %]|[% expire_time %][%- IF hold != holds.last %]+@+[% END -%]
[%- END %]
