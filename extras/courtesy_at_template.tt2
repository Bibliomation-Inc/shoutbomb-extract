[%- USE date -%]
[%- user = target.0.usr -%]
[%- circs = target -%]
[%- sms_number = user_data.sms_notify -%]
[%- sanitized_sms = sms_number.replace('[-\s()]', '', 'g') -%]
To: [%- params.recipient_email %]
Bcc: [%- params.bcc_email || '' %]
From: [%- params.sender_email %]
Date: [%- date.format(date.now, '%a, %d %b %Y %T -0000', gmt => 1) %]
Subject: PREOVERDUE+[% sanitized_sms %]
Auto-Submitted: auto-generated

[% FOR circ IN circs %]
[%- copy_details = helpers.get_copy_bib_basics(circ.target_copy.id) -%]
[% user_barcode = user.card.barcode %]
[% copy_barcode = circ.target_copy.barcode %]
[% title = copy_details.title %]
[% due_date = date.format(helpers.format_date(circ.due_date), '%Y-%m-%d') %]
[% result = helpers.check_renew_eligibility(circ, user, 0) %]
[% user_barcode %]|[% copy_barcode %]|[% title %]|[% due_date %]|[% result.eligible ? 'YES' : 'NO' %]|[% result.desc %]
[% END %]